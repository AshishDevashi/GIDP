APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wolf_platform?sslmode=disable
JWT_SECRET=dev-secret-change-me
JWT_TTL=24h
GITHUB_TOKEN=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKERHUB_NAMESPACE=

# DB instance provisioning. AWS credentials are read from the standard AWS
# credential chain (~/.aws/credentials, env vars, instance profile).
AWS_REGION=us-east-1
DB_INSTANCE_TYPE=t3.micro
DB_INSTANCE_STORAGE_GB=20
DB_INSTANCE_ROOT_VOLUME_GB=10
DB_INSTANCE_POSTGRES_PORT=5432
DB_INSTANCE_POSTGRES_IMAGE=postgres:16-alpine
DB_INSTANCE_ADMIN_USERNAME=gidp
DB_INSTANCE_CONTAINER_NAME=gidp-postgres
DB_INSTANCE_DATA_DEVICE_NAME=/dev/sdf
DB_INSTANCE_DATA_MOUNT_POINT=/var/lib/gidp/postgres
# Restrict these to your own CIDR before using outside a sandbox account.
DB_INSTANCE_SSH_INGRESS_CIDR=0.0.0.0/0
DB_INSTANCE_POSTGRES_INGRESS_CIDR=0.0.0.0/0
DB_INSTANCE_PROVISION_TIMEOUT=20m
DB_INSTANCE_READINESS_TIMEOUT=10m
# Leave empty to look terraform up on PATH.
TERRAFORM_BIN_PATH=
TERRAFORM_MODULE_DIR=deploy/terraform/modules/ec2-instance
TERRAFORM_WORK_DIR=deploy/terraform/.workspaces
SSH_KEY_DIR=deploy/keys
